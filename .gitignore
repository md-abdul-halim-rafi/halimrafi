# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent tooling (restore with skills-lock.json, which stays tracked)
/.agents/
/.claude/skills/
/.claude/settings.local.json

# working notes and briefs
# Kept out of the repository because it is public: these hold research notes
# about a private codebase, internal identifiers and per-person contribution
# analysis, none of which the site needs to build.
/docs/
